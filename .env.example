# HubSpot Forms API — used to capture quiz leads.
# These are NOT secrets: the Forms submit endpoint is meant to be called from the
# browser. Find them in HubSpot: Marketing → Forms → (your form) → Share/Embed,
# or in the embed code (portalId + formId/guid).
VITE_HUBSPOT_PORTAL_ID=6188528
VITE_HUBSPOT_FORM_GUID=
