# HubSpot Forms API — used to capture quiz leads.
# These are NOT secrets: the Forms submit endpoint is meant to be called from the
# browser. Find them in HubSpot: Marketing → Forms → (your form) → Share/Embed,
# or in the embed code (portalId + formId/guid).
VITE_HUBSPOT_PORTAL_ID=6188528
VITE_HUBSPOT_FORM_GUID=

# Supabase backup — durable copy of every quiz lead.
# Use the publishable key only (safe in the browser with insert-only RLS).
# NEVER put the secret key in a VITE_ variable — it would be exposed in the client bundle.
# Project URL: Dashboard → Project Settings → API
# Then run supabase/quiz_submissions.sql in the SQL Editor once.
VITE_SUPABASE_URL=https://ogqktwnmrphjzfvpfhyl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
